<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - EnglishKafe</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="#">EnglishKafe Admin</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/">View Site</a>
                <form action="/logout" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-outline-light">Logout</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <h1>Admin Panel</h1>
        <div class="mb-3">
            <ul class="nav nav-pills">
                <li class="nav-item"><button type="button" class="nav-link active" data-section="home">Home</button></li>
                <li class="nav-item"><button type="button" class="nav-link" data-section="about">About</button></li>
                <li class="nav-item"><button type="button" class="nav-link" data-section="services">Services</button></li>
                <li class="nav-item"><button type="button" class="nav-link" data-section="courses">Courses</button></li>
                <li class="nav-item"><button type="button" class="nav-link" data-section="instructors">Instructors</button></li>
                <li class="nav-item"><button type="button" class="nav-link" data-section="videos">YouTube Videos</button></li>
                <li class="nav-item"><button type="button" class="nav-link" data-section="cloud">Cloud Videos</button></li>
            </ul>
        </div>
        <% if (warning) { %>
            <div class="alert alert-warning mt-3" role="alert">
                <strong>Warning:</strong> <%= warning %>
            </div>
        <% } %>

    <!-- Home Section -->
    <div class="card mb-4 admin-section" data-section="home">
            <div class="card-header">
                <h5>Home Section</h5>
            </div>
            <div class="card-body">
                <form action="/admin/content" method="POST" class="mb-3">
                    <input type="hidden" name="section" value="home">
                    <div class="row">
                        <div class="col-md-4">
                            <label>Slide 1 Title</label>
                            <input type="text" name="key" value="slide1_title" class="form-control" readonly>
                            <input type="text" name="value" value="<%= content.home ? content.home.slide1_title : '' %>" class="form-control mt-1">
                        </div>
                        <div class="col-md-4">
                            <label>Slide 1 Text</label>
                            <input type="text" name="key" value="slide1_text" class="form-control" readonly>
                            <textarea name="value" class="form-control mt-1"><%= content.home ? content.home.slide1_text : '' %></textarea>
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-primary mt-4">Update Slide 1</button>
                        </div>
                    </div>
                </form>
                <!-- Similar forms for slide 2 and 3 -->
                <form action="/admin/content" method="POST" class="mb-3">
                    <input type="hidden" name="section" value="home">
                    <div class="row">
                        <div class="col-md-4">
                            <label>Slide 2 Title</label>
                            <input type="text" name="key" value="slide2_title" class="form-control" readonly>
                            <input type="text" name="value" value="<%= content.home ? content.home.slide2_title : '' %>" class="form-control mt-1">
                        </div>
                        <div class="col-md-4">
                            <label>Slide 2 Text</label>
                            <input type="text" name="key" value="slide2_text" class="form-control" readonly>
                            <textarea name="value" class="form-control mt-1"><%= content.home ? content.home.slide2_text : '' %></textarea>
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-primary mt-4">Update Slide 2</button>
                        </div>
                    </div>
                </form>
                <form action="/admin/content" method="POST" class="mb-3">
                    <input type="hidden" name="section" value="home">
                    <div class="row">
                        <div class="col-md-4">
                            <label>Slide 3 Title</label>
                            <input type="text" name="key" value="slide3_title" class="form-control" readonly>
                            <input type="text" name="value" value="<%= content.home ? content.home.slide3_title : '' %>" class="form-control mt-1">
                        </div>
                        <div class="col-md-4">
                            <label>Slide 3 Text</label>
                            <input type="text" name="key" value="slide3_text" class="form-control" readonly>
                            <textarea name="value" class="form-control mt-1"><%= content.home ? content.home.slide3_text : '' %></textarea>
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-primary mt-4">Update Slide 3</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

    <!-- About Section -->
    <div class="card mb-4 admin-section" data-section="about">
            <div class="card-header">
                <h5>About Section</h5>
            </div>
            <div class="card-body">
                <form action="/admin/content" method="POST" class="mb-3">
                    <input type="hidden" name="section" value="about">
                    <div class="row">
                        <div class="col-md-6">
                            <label>Title</label>
                            <input type="text" name="key" value="title" class="form-control" readonly>
                            <input type="text" name="value" value="<%= content.about ? content.about.title : '' %>" class="form-control mt-1">
                        </div>
                        <div class="col-md-6">
                            <button type="submit" class="btn btn-primary mt-4">Update Title</button>
                        </div>
                    </div>
                </form>
                <form action="/admin/content" method="POST" class="mb-3">
                    <input type="hidden" name="section" value="about">
                    <div class="row">
                        <div class="col-md-6">
                            <label>Text 1</label>
                            <input type="text" name="key" value="text1" class="form-control" readonly>
                            <textarea name="value" class="form-control mt-1"><%= content.about ? content.about.text1 : '' %></textarea>
                        </div>
                        <div class="col-md-6">
                            <button type="submit" class="btn btn-primary mt-4">Update Text 1</button>
                        </div>
                    </div>
                </form>
                <form action="/admin/content" method="POST" class="mb-3">
                    <input type="hidden" name="section" value="about">
                    <div class="row">
                        <div class="col-md-6">
                            <label>Text 2</label>
                            <input type="text" name="key" value="text2" class="form-control" readonly>
                            <textarea name="value" class="form-control mt-1"><%= content.about ? content.about.text2 : '' %></textarea>
                        </div>
                        <div class="col-md-6">
                            <button type="submit" class="btn btn-primary mt-4">Update Text 2</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

    <!-- Services Section -->
    <div class="card mb-4 admin-section" data-section="services">
            <div class="card-header">
                <h5>Services Section</h5>
            </div>
            <div class="card-body">
                <!-- Forms for each service -->
                <form action="/admin/content" method="POST" class="mb-3">
                    <input type="hidden" name="section" value="services">
                    <div class="row">
                        <div class="col-md-3">
                            <label>Home Delivery Title</label>
                            <input type="text" name="key" value="home_delivery_title" class="form-control" readonly>
                            <input type="text" name="value" value="<%= content.services ? content.services.home_delivery_title : '' %>" class="form-control mt-1">
                        </div>
                        <div class="col-md-6">
                            <label>Home Delivery Text</label>
                            <input type="text" name="key" value="home_delivery_text" class="form-control" readonly>
                            <textarea name="value" class="form-control mt-1"><%= content.services ? content.services.home_delivery_text : '' %></textarea>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary mt-4">Update</button>
                        </div>
                    </div>
                </form>
                                <!-- Similar for other services -->

                                <!-- Manage service cards (uses the same `menu` table as Courses) -->
                                <hr />
                                <h6>Manage Service Cards</h6>
                                <form action="/admin/menu" method="POST" enctype="multipart/form-data" class="mb-3">
                                        <div class="row">
                                                <div class="col-md-3">
                                                        <label>Title</label>
                                                        <input type="text" name="name" class="form-control" placeholder="Course title">
                                                </div>
                                                <div class="col-md-5">
                                                        <label>Description</label>
                                                        <input type="text" name="description" class="form-control" placeholder="Short description">
                                                </div>
                                                <div class="col-md-2">
                                                        <label>Price</label>
                                                        <input type="number" step="0.01" name="price" class="form-control" placeholder="Price">
                                                </div>
                                                <div class="col-md-2">
                                                        <label>Image</label>
                                                        <input type="file" name="image" class="form-control" accept="image/*">
                                                </div>
                                        </div>
                                        <div class="row mt-2">
                                                <div class="col-md-12">
                                                        <button type="submit" class="btn btn-success">Add Service Card</button>
                                                </div>
                                        </div>
                                </form>

                                <div class="row">
                                    <% if (menu && menu.length) { %>
                                        <% menu.forEach(item => { %>
                                            <div class="col-md-4 mb-3">
                                                <div class="card">
                                                    <img src="<%= item.image || 'images/default-menu.jpg' %>" class="card-img-top" alt="<%= item.name %>">
                                                    <div class="card-body">
                                                        <h6><%= item.name %></h6>
                                                        <p><%= item.description %></p>
                                                        <p><strong>Baht <%= item.price %></strong></p>
                                                        <div class="d-flex gap-2">
                                                            <button class="btn btn-primary btn-sm" data-bs-toggle="collapse" data-bs-target="#edit-menu-<%= item.id %>">Edit</button>
                                                            <form action="/admin/menu/delete/<%= item.id %>" method="POST" class="d-inline">
                                                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                                            </form>
                                                        </div>
                                                        <div class="collapse mt-3" id="edit-menu-<%= item.id %>">
                                                            <form action="/admin/menu/update/<%= item.id %>" method="POST" enctype="multipart/form-data">
                                                                <div class="mb-2">
                                                                    <label>Title</label>
                                                                    <input type="text" name="name" class="form-control" value="<%= item.name %>">
                                                                </div>
                                                                <div class="mb-2">
                                                                    <label>Description</label>
                                                                    <textarea name="description" class="form-control"><%= item.description %></textarea>
                                                                </div>
                                                                <div class="mb-2">
                                                                    <label>Price</label>
                                                                    <input type="number" step="0.01" name="price" class="form-control" value="<%= item.price %>">
                                                                </div>
                                                                <div class="mb-2">
                                                                    <label>Image (optional)</label>
                                                                    <input type="file" name="image" class="form-control" accept="image/*">
                                                                </div>
                                                                <button type="submit" class="btn btn-success btn-sm">Save</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        <% }); %>
                                    <% } else { %>
                                        <div class="col-12">
                                            <p class="text-muted">No service cards yet. Use the Add form above to create one.</p>
                                        </div>
                                    <% } %>
                                </div>
            </div>
        </div>

        <!-- Menu Section -->
    <div class="card mb-4 admin-section" data-section="courses">
            <div class="card-header">
                <h5>Courses</h5>
            </div>
            <div class="card-body">
                <form action="/admin/menu" method="POST" enctype="multipart/form-data" class="mb-3">
                    <div class="row">
                        <div class="col-md-3">
                            <label>Name</label>
                            <input type="text" name="name" class="form-control" required>
                        </div>
                        <div class="col-md-3">
                            <label>Description</label>
                            <textarea name="description" class="form-control" required></textarea>
                        </div>
                        <div class="col-md-2">
                            <label>Price</label>
                            <input type="number" step="0.01" name="price" class="form-control" required>
                        </div>
                        <div class="col-md-2">
                            <label>Image</label>
                            <input type="file" name="image" class="form-control" accept="image/*">
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-success mt-4">Add Course</button>
                        </div>
                    </div>
                </form>
                <div class="row">
                    <% menu.forEach(item => { %>
                        <div class="col-md-4 mb-3">
                            <div class="card">
                                <img src="<%= item.image || 'images/default-menu.jpg' %>" class="card-img-top" alt="<%= item.name %>">
                                <div class="card-body">
                                    <h6><%= item.name %></h6>
                                    <p><%= item.description %></p>
                                    <p><strong>Baht <%= item.price %></strong></p>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-primary btn-sm" data-bs-toggle="collapse" data-bs-target="#edit-course-<%= item.id %>">Edit</button>
                                        <form action="/admin/menu/delete/<%= item.id %>" method="POST" class="d-inline">
                                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                        </form>
                                    </div>

                                    <div class="collapse mt-3" id="edit-course-<%= item.id %>">
                                        <form action="/admin/menu/update/<%= item.id %>" method="POST" enctype="multipart/form-data">
                                            <div class="mb-2">
                                                <label>Title</label>
                                                <input type="text" name="name" class="form-control" value="<%= item.name %>" required>
                                            </div>
                                            <div class="mb-2">
                                                <label>Description</label>
                                                <textarea name="description" class="form-control" required><%= item.description %></textarea>
                                            </div>
                                            <div class="mb-2">
                                                <label>Price</label>
                                                <input type="number" step="0.01" name="price" class="form-control" value="<%= item.price %>" required>
                                            </div>
                                            <div class="mb-2">
                                                <label>Image (optional)</label>
                                                <input type="file" name="image" class="form-control" accept="image/*">
                                            </div>
                                            <div class="d-flex gap-2">
                                                <button type="submit" class="btn btn-success btn-sm">Save</button>
                                                <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="collapse" data-bs-target="#edit-course-<%= item.id %>">Cancel</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        </div>

        <!-- Chefs Section -->
    <div class="card mb-4 admin-section" data-section="instructors">
            <div class="card-header">
                <h5>Instructors</h5>
            </div>
            <div class="card-body">
                <form action="/admin/chef" method="POST" enctype="multipart/form-data" class="mb-3">
                    <div class="row">
                        <div class="col-md-4">
                            <label>Name</label>
                            <input type="text" name="name" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label>Description</label>
                            <textarea name="description" class="form-control" rows="3" required></textarea>
                        </div>
                        <div class="col-md-2">
                            <label>Image</label>
                            <input type="file" name="image" class="form-control" accept="image/*">
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-success mt-4">Add Instructor</button>
                        </div>
                    </div>
                </form>
                <div class="row">
                    <% chefs.forEach(chef => { %>
                        <div class="col-md-4 mb-3">
                            <div class="card">
                                <img src="<%= chef.image || 'images/default-chef.jpg' %>" class="card-img-top" alt="<%= chef.name %>">
                                <div class="card-body">
                                    <h6><%= chef.name %></h6>
                                    <p><%= chef.role %></p>
                                    <form action="/admin/chef/delete/<%= chef.id %>" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        </div>

        <!-- Videos Section -->
    <div class="card mb-4 admin-section" data-section="videos">
            <div class="card-header">
                <h5>Lesson Videos</h5>
            </div>
            <div class="card-body">
                <form action="/admin/video" method="POST" class="mb-3">
                    <div class="row">
                        <input type="hidden" name="host" value="youtube">
                        <div class="col-md-4">
                            <label>Title</label>
                            <input type="text" name="title" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label>YouTube Link</label>
                            <input type="url" name="youtube_link" class="form-control" placeholder="https://www.youtube.com/watch?v=VIDEO_ID" required>
                        </div>
                        <div class="col-md-6 mt-2">
                            <label>Description</label>
                            <textarea name="description" class="form-control" placeholder="Short description to show under the video"></textarea>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-success mt-4">Add Video</button>
                        </div>
                    </div>
                </form>
                <div class="row">
                    <% videos.forEach(video => { %>
                        <div class="col-md-4 mb-3">
                            <div class="card">
                                <div class="card-body">
                                    <h6><%= video.title %></h6>
                                    <p class="text-muted small"><%= video.youtube_link %></p>
                                    <% if (video.description) { %>
                                      <p><%= video.description %></p>
                                    <% } %>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-primary btn-sm" data-bs-toggle="collapse" data-bs-target="#edit-video-<%= video.id %>">Edit</button>
                                        <form action="/admin/video/delete/<%= video.id %>" method="POST" class="d-inline">
                                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                        </form>
                                    </div>

                                    <div class="collapse mt-3" id="edit-video-<%= video.id %>">
                                        <form action="/admin/video/update/<%= video.id %>" method="POST">
                                            <input type="hidden" name="host" value="youtube">
                                            <div class="mb-2">
                                                <label>Title</label>
                                                <input type="text" name="title" class="form-control" value="<%= video.title %>">
                                            </div>
                                            <div class="mb-2">
                                                <label>YouTube Link</label>
                                                <input type="url" name="youtube_link" class="form-control" value="<%= video.youtube_link %>">
                                            </div>
                                            <div class="mb-2">
                                                <label>Description</label>
                                                <textarea name="description" class="form-control"><%= video.description %></textarea>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <button type="submit" class="btn btn-success btn-sm">Save</button>
                                                <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="collapse" data-bs-target="#edit-video-<%= video.id %>">Cancel</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        </div>

    <!-- Cloud Videos Section -->
    <div class="card mb-4 admin-section" data-section="cloud">
            <div class="card-header">
                <h5>Cloud Videos</h5>
            </div>
            <div class="card-body">
                <form action="/admin/video" method="POST" class="mb-3">
                    <input type="hidden" name="host" value="cloud">
                    <div class="row">
                        <div class="col-md-4">
                            <label>Title</label>
                            <input type="text" name="title" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label>Cloud Video Link (MP4 or direct URL)</label>
                            <input type="url" name="cloud_link" class="form-control" placeholder="https://cdn.example.com/path/video.mp4" required>
                        </div>
                        <div class="col-md-6 mt-2">
                            <label>Description</label>
                            <textarea name="description" class="form-control" placeholder="Short description to show under the video"></textarea>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-success mt-4">Add Cloud Video</button>
                        </div>
                        <div class="col-md-2">
                            <button type="button" id="test-cloud-url" class="btn btn-outline-primary mt-4">Test URL</button>
                        </div>
                    </div>
                </form>
                <div id="cloud-check-result" class="mt-3"></div>

                <div class="row">
                    <% if (typeof cloudVideos !== 'undefined' && cloudVideos.length) { %>
                        <% cloudVideos.forEach(video => { %>
                            <div class="col-md-4 mb-3">
                                <div class="card">
                                    <div class="card-body">
                                        <h6><%= video.title %></h6>
                                        <p class="text-muted small"><%= video.cloud_link %></p>
                                        <% if (video.description) { %>
                                          <p><%= video.description %></p>
                                        <% } %>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-primary btn-sm" data-bs-toggle="collapse" data-bs-target="#edit-cloud-<%= video.id %>">Edit</button>
                                            <form action="/admin/video/delete/<%= video.id %>" method="POST" class="d-inline">
                                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                            </form>
                                        </div>

                                        <div class="collapse mt-3" id="edit-cloud-<%= video.id %>">
                                            <form action="/admin/video/update/<%= video.id %>" method="POST">
                                                <input type="hidden" name="host" value="cloud">
                                                <div class="mb-2">
                                                    <label>Title</label>
                                                    <input type="text" name="title" class="form-control" value="<%= video.title %>">
                                                </div>
                                                <div class="mb-2">
                                                    <label>Cloud Link</label>
                                                    <input type="url" name="cloud_link" class="form-control" value="<%= video.cloud_link %>">
                                                </div>
                                                <div class="mb-2">
                                                    <label>Description</label>
                                                    <textarea name="description" class="form-control"><%= video.description %></textarea>
                                                </div>
                                                <div class="d-flex gap-2">
                                                    <button type="submit" class="btn btn-success btn-sm">Save</button>
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="collapse" data-bs-target="#edit-cloud-<%= video.id %>">Cancel</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="col-12">
                            <p class="text-muted">No cloud-hosted videos yet.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            // Tab switching for admin sections
            (function(){
                const buttons = document.querySelectorAll('.nav-pills [data-section]');
                const sections = document.querySelectorAll('.admin-section');
                function showSection(name){
                    sections.forEach(s => {
                        if (s.getAttribute('data-section') === name) s.style.display = '';
                        else s.style.display = 'none';
                    });
                    buttons.forEach(b => b.classList.toggle('active', b.getAttribute('data-section') === name));
                }
                buttons.forEach(b => b.addEventListener('click', ()=> showSection(b.getAttribute('data-section'))));
                // initial show
                showSection('home');
            })();

            // Cloud URL test button
            (function(){
                const btn = document.getElementById('test-cloud-url');
                if (!btn) return;
                const resultEl = document.getElementById('cloud-check-result');
                btn.addEventListener('click', async () => {
                    // get cloud link from the form input
                    const input = document.querySelector('input[name="cloud_link"]');
                    if (!input) return;
                    const url = input.value.trim();
                    if (!url) { resultEl.innerHTML = '<div class="alert alert-warning">Please enter a URL first.</div>'; return; }
                    resultEl.innerHTML = '<div class="alert alert-info">Checking URL...</div>';
                    try {
                        const resp = await fetch('/admin/check-url', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'same-origin',
                            body: JSON.stringify({ url })
                        });
                        if (!resp.ok) {
                            const err = await resp.json().catch(()=>({ error: resp.statusText }));
                            resultEl.innerHTML = `<div class="alert alert-danger">Check failed: ${err.error || resp.statusText}</div>`;
                            return;
                        }
                        const data = await resp.json();
                        const parts = [];
                        parts.push(`<strong>Status:</strong> ${data.statusCode}`);
                        if (data.headers && data.headers['content-type']) parts.push(`<strong>Content-Type:</strong> ${data.headers['content-type']}`);
                        if (data.headers && (data.headers['accept-ranges'] || data.headers['Accept-Ranges'])) parts.push(`<strong>Accept-Ranges:</strong> ${data.headers['accept-ranges'] || data.headers['Accept-Ranges']}`);
                        const warnHtml = (data.warnings && data.warnings.length) ? `<div class="mt-2"><strong>Warnings:</strong><ul>${data.warnings.map(w=>`<li>${w}</li>`).join('')}</ul></div>` : '';
                        resultEl.innerHTML = `<div class="alert alert-success">${parts.join('<br/>')}${warnHtml}</div>`;
                    } catch (err) {
                        resultEl.innerHTML = `<div class="alert alert-danger">Error: ${err.message}</div>`;
                    }
                });
            })();
        </script>
</body>
</html>