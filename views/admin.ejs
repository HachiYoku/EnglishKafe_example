<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - Brio Restaurant</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="#">Brio Admin</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/">View Site</a>
                <form action="/logout" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-outline-light">Logout</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <h1>Admin Panel</h1>

        <!-- Home Section -->
        <div class="card mb-4">
            <div class="card-header">
                <h5>Home Section</h5>
            </div>
            <div class="card-body">
                <form action="/admin/content" method="POST" class="mb-3">
                    <input type="hidden" name="section" value="home">
                    <div class="row">
                        <div class="col-md-4">
                            <label>Slide 1 Title</label>
                            <input type="text" name="key" value="slide1_title" class="form-control" readonly>
                            <input type="text" name="value" value="<%= content.home ? content.home.slide1_title : '' %>" class="form-control mt-1">
                        </div>
                        <div class="col-md-4">
                            <label>Slide 1 Text</label>
                            <input type="text" name="key" value="slide1_text" class="form-control" readonly>
                            <textarea name="value" class="form-control mt-1"><%= content.home ? content.home.slide1_text : '' %></textarea>
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-primary mt-4">Update Slide 1</button>
                        </div>
                    </div>
                </form>
                <!-- Similar forms for slide 2 and 3 -->
                <form action="/admin/content" method="POST" class="mb-3">
                    <input type="hidden" name="section" value="home">
                    <div class="row">
                        <div class="col-md-4">
                            <label>Slide 2 Title</label>
                            <input type="text" name="key" value="slide2_title" class="form-control" readonly>
                            <input type="text" name="value" value="<%= content.home ? content.home.slide2_title : '' %>" class="form-control mt-1">
                        </div>
                        <div class="col-md-4">
                            <label>Slide 2 Text</label>
                            <input type="text" name="key" value="slide2_text" class="form-control" readonly>
                            <textarea name="value" class="form-control mt-1"><%= content.home ? content.home.slide2_text : '' %></textarea>
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-primary mt-4">Update Slide 2</button>
                        </div>
                    </div>
                </form>
                <form action="/admin/content" method="POST" class="mb-3">
                    <input type="hidden" name="section" value="home">
                    <div class="row">
                        <div class="col-md-4">
                            <label>Slide 3 Title</label>
                            <input type="text" name="key" value="slide3_title" class="form-control" readonly>
                            <input type="text" name="value" value="<%= content.home ? content.home.slide3_title : '' %>" class="form-control mt-1">
                        </div>
                        <div class="col-md-4">
                            <label>Slide 3 Text</label>
                            <input type="text" name="key" value="slide3_text" class="form-control" readonly>
                            <textarea name="value" class="form-control mt-1"><%= content.home ? content.home.slide3_text : '' %></textarea>
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-primary mt-4">Update Slide 3</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- About Section -->
        <div class="card mb-4">
            <div class="card-header">
                <h5>About Section</h5>
            </div>
            <div class="card-body">
                <form action="/admin/content" method="POST" class="mb-3">
                    <input type="hidden" name="section" value="about">
                    <div class="row">
                        <div class="col-md-6">
                            <label>Title</label>
                            <input type="text" name="key" value="title" class="form-control" readonly>
                            <input type="text" name="value" value="<%= content.about ? content.about.title : '' %>" class="form-control mt-1">
                        </div>
                        <div class="col-md-6">
                            <button type="submit" class="btn btn-primary mt-4">Update Title</button>
                        </div>
                    </div>
                </form>
                <form action="/admin/content" method="POST" class="mb-3">
                    <input type="hidden" name="section" value="about">
                    <div class="row">
                        <div class="col-md-6">
                            <label>Text 1</label>
                            <input type="text" name="key" value="text1" class="form-control" readonly>
                            <textarea name="value" class="form-control mt-1"><%= content.about ? content.about.text1 : '' %></textarea>
                        </div>
                        <div class="col-md-6">
                            <button type="submit" class="btn btn-primary mt-4">Update Text 1</button>
                        </div>
                    </div>
                </form>
                <form action="/admin/content" method="POST" class="mb-3">
                    <input type="hidden" name="section" value="about">
                    <div class="row">
                        <div class="col-md-6">
                            <label>Text 2</label>
                            <input type="text" name="key" value="text2" class="form-control" readonly>
                            <textarea name="value" class="form-control mt-1"><%= content.about ? content.about.text2 : '' %></textarea>
                        </div>
                        <div class="col-md-6">
                            <button type="submit" class="btn btn-primary mt-4">Update Text 2</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Services Section -->
        <div class="card mb-4">
            <div class="card-header">
                <h5>Services Section</h5>
            </div>
            <div class="card-body">
                <!-- Forms for each service -->
                <form action="/admin/content" method="POST" class="mb-3">
                    <input type="hidden" name="section" value="services">
                    <div class="row">
                        <div class="col-md-3">
                            <label>Home Delivery Title</label>
                            <input type="text" name="key" value="home_delivery_title" class="form-control" readonly>
                            <input type="text" name="value" value="<%= content.services ? content.services.home_delivery_title : '' %>" class="form-control mt-1">
                        </div>
                        <div class="col-md-6">
                            <label>Home Delivery Text</label>
                            <input type="text" name="key" value="home_delivery_text" class="form-control" readonly>
                            <textarea name="value" class="form-control mt-1"><%= content.services ? content.services.home_delivery_text : '' %></textarea>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary mt-4">Update Home Delivery</button>
                        </div>
                    </div>
                </form>
                <!-- Similar for other services -->
            </div>
        </div>

        <!-- Menu Section -->
        <div class="card mb-4">
            <div class="card-header">
                <h5>Menu Items</h5>
            </div>
            <div class="card-body">
                <form action="/admin/menu" method="POST" enctype="multipart/form-data" class="mb-3">
                    <div class="row">
                        <div class="col-md-3">
                            <label>Name</label>
                            <input type="text" name="name" class="form-control" required>
                        </div>
                        <div class="col-md-3">
                            <label>Description</label>
                            <textarea name="description" class="form-control" required></textarea>
                        </div>
                        <div class="col-md-2">
                            <label>Price</label>
                            <input type="number" step="0.01" name="price" class="form-control" required>
                        </div>
                        <div class="col-md-2">
                            <label>Image</label>
                            <input type="file" name="image" class="form-control" accept="image/*">
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-success mt-4">Add Menu Item</button>
                        </div>
                    </div>
                </form>
                <div class="row">
                    <% menu.forEach(item => { %>
                        <div class="col-md-4 mb-3">
                            <div class="card">
                                <img src="<%= item.image || 'images/default-menu.jpg' %>" class="card-img-top" alt="<%= item.name %>">
                                <div class="card-body">
                                    <h6><%= item.name %></h6>
                                    <p><%= item.description %></p>
                                    <p><strong>$<%= item.price %></strong></p>
                                    <form action="/admin/menu/delete/<%= item.id %>" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        </div>

        <!-- Chefs Section -->
        <div class="card mb-4">
            <div class="card-header">
                <h5>Chefs</h5>
            </div>
            <div class="card-body">
                <form action="/admin/chef" method="POST" enctype="multipart/form-data" class="mb-3">
                    <div class="row">
                        <div class="col-md-4">
                            <label>Name</label>
                            <input type="text" name="name" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label>Role</label>
                            <input type="text" name="role" class="form-control" required>
                        </div>
                        <div class="col-md-2">
                            <label>Image</label>
                            <input type="file" name="image" class="form-control" accept="image/*">
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-success mt-4">Add Chef</button>
                        </div>
                    </div>
                </form>
                <div class="row">
                    <% chefs.forEach(chef => { %>
                        <div class="col-md-4 mb-3">
                            <div class="card">
                                <img src="<%= chef.image || 'images/default-chef.jpg' %>" class="card-img-top" alt="<%= chef.name %>">
                                <div class="card-body">
                                    <h6><%= chef.name %></h6>
                                    <p><%= chef.role %></p>
                                    <form action="/admin/chef/delete/<%= chef.id %>" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        </div>

        <!-- Videos Section -->
        <div class="card mb-4">
            <div class="card-header">
                <h5>Videos</h5>
            </div>
            <div class="card-body">
                <form action="/admin/video" method="POST" class="mb-3">
                    <div class="row">
                        <div class="col-md-4">
                            <label>Title</label>
                            <input type="text" name="title" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label>YouTube Link</label>
                            <input type="url" name="youtube_link" class="form-control" placeholder="https://www.youtube.com/watch?v=VIDEO_ID" required>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-success mt-4">Add Video</button>
                        </div>
                    </div>
                </form>
                <div class="row">
                    <% videos.forEach(video => { %>
                        <div class="col-md-4 mb-3">
                            <div class="card">
                                <div class="card-body">
                                    <h6><%= video.title %></h6>
                                    <p><%= video.youtube_link %></p>
                                    <form action="/admin/video/delete/<%= video.id %>" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>