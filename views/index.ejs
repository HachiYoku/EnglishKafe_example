      </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/scroll.js"></script>
    <!-- hls.js for playing .m3u8 HLS manifests from cloud hosts (e.g. Bunny.net Stream/Storage) -->
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('video[data-cloud-link]').forEach(function(videoEl) {
          const url = videoEl.getAttribute('data-cloud-link');
          if (!url) return;

          // If link looks like HLS manifest (.m3u8)
          if (url.endsWith('.m3u8')) {
            if (window.Hls && Hls.isSupported()) {
              const hls = new Hls();
              hls.loadSource(url);
              hls.attachMedia(videoEl);
            } else if (videoEl.canPlayType('application/vnd.apple.mpegurl')) {
              // Safari supports HLS natively
              videoEl.src = url;
            } else {
              console.warn('HLS not supported in this browser');
            }
          } else {
            // For MP4 and other direct video files just set the src
            videoEl.src = url;
          }
        });
      });
    </script>
  </body>
</html>