<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="images/favicon-16x16.png" />

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lobster&family=Spline+Sans:wght@300..700&family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <!-- animate css  -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"
    />
    <!-- local css  -->
    <link rel="stylesheet" href="styles.css" />
  <title>EnglishKafe</title>
  </head>
  <body>

    <!-- navbar-sec -->
    <div class="navbar-sec">
        <nav class="navbar navbar-expand-lg bg-body-tertiary">
            <div class="container-fluid d-flex justify-content-between align-items-center">
              <a class="navbar-brand mx-4 my-auto" href="#">EnglishKafe</a>
              <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
              </button>
              <div class="collapse navbar-collapse justify-content-end" id="navbarNavDropdown">
                <ul class="navbar-nav">
                  <li class="nav-item">
                    <a class="nav-link mx-3" aria-current="page" href="#home-sec">Home</a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link mx-3" href="#about-sec">About us</a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link mx-3" href="#service-sec">services</a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link mx-3" href="#menu-sec">Courses</a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link mx-3" href="#chef-sec">Instructors</a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link mx-3" href="#videos-sec">Lessons</a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link mx-3" href="#enrollment-sec">Enroll</a>
                  </li>
                </ul>
              </div>
            </div>
          </nav>
    </div>

    <!-- home-sec  -->
    <section id="home-sec">
        <div id="carouselExampleCaptions" class="carousel slide" data-bs-ride="true">
            <div class="carousel-indicators">
              <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
              <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="1" aria-label="Slide 2"></button>
              <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="2" aria-label="Slide 3"></button>
            </div>
            <div class="carousel-inner">
              <div class="carousel-item active">
                <div class="carousel-overlay"></div>
                <img src="images/P4.jpg" class="d-block w-100" alt="hero-img-1">
                <div class="carousel-caption d-none d-md-block">
                  <h1><%= content.home ? content.home.slide1_title : 'Learn English with EnglishKafe' %></h1>
                  <p class="mt-4"><%= content.home ? content.home.slide1_text : 'Some representative placeholder content for the first slide.' %></p>
                  <button type="button" class="btn btn-warning px-4 py-2">Get Start</button>
                </div>
              </div>
              <div class="carousel-item">
                <div class="carousel-overlay"></div>
                <img src="images/P1.jpg" class="d-block w-100" alt="hero-img-2">
                <div class="carousel-caption d-none d-md-block">
                  <h1><%= content.home ? content.home.slide2_title : 'Speak Confidently' %></h1>
                  <p class="mt-4"><%= content.home ? content.home.slide2_text : 'Some representative placeholder content for the second slide.' %></p>
                  <button type="button" class="btn btn-warning px-4 py-2">Get Start</button>
                </div>
              </div>
              <div class="carousel-item">
                <div class="carousel-overlay"></div>
                <img src="images/P2.jpg" class="d-block w-100" alt="hero-img-3">
                <div class="carousel-caption d-none d-md-block">
                  <h1><%= content.home ? content.home.slide3_title : 'Prepare for Exams' %></h1>
                  <p class="mt-4"><%= content.home ? content.home.slide3_text : 'Some representative placeholder content for the third slide.' %></p>
                  <button type="button" class="btn btn-warning px-4 py-2">Get Start</button>
                </div>
              </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="prev">
              <span class="carousel-control-prev-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="next">
              <span class="carousel-control-next-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Next</span>
            </button>
          </div>
    </section>

    <!-- About-sec  -->
     <section id="about-sec">
        <div class="container">
            <div class="row">
                <div class="col-12 mt-5 mb-3">
                    <h1 class="text-center my-4 mx-2 px-4 py-4"><%= content.about ? content.about.title : 'About Us' %></h1>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 d-block about-text mt-4 mb-4">
                    <h2><span class="first-text">About</span> <span class="second-text">EnglishKafe</span></h2>
                    <p class="first-p mt-4"><%= content.about ? content.about.text1 : 'EnglishKafe offers structured courses and live practice sessions to help learners gain confidence and real-world English skills.' %></p>
                    <p class="second-p mt-3"><%= content.about ? content.about.text2 : 'We blend interactive lessons, video content, and community practice to make learning effective and enjoyable.' %></p>
                </div>
                <div class="col-md-6 about-img mt-4 mb-4">
                    <div id="carouselExampleInterval" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner">
                          <div class="carousel-item active" data-bs-interval="10000">
                            <img src="images/ENGLISH KAFE.jpg" class="d-block w-100" alt="...">
                          </div>
                          <div class="carousel-item" data-bs-interval="2000">
                            <img src="images/ENGLISH-KAFE1.jpg" class="d-block w-100" alt="...">
                          </div>
                          <div class="carousel-item">
                            <img src="images/ENGLISH-KAFE2.jpg" class="d-block w-100" alt="...">
                          </div>
                        </div>
                      </div>
                </div>
            </div>
        </div>
     </section>

            <!-- cloud-videos-sec -->
            <section id="cloud-videos-sec">
              <div class="container">
                <div class="row">
                  <div class="col-12 mt-5 mb-3">
                    <h1 class="text-center my-4 mx-2 px-4 py-4">Cloud Videos</h1>
                  </div>
                </div>
                <div class="row">
                  <% if (typeof cloudVideos !== 'undefined' && cloudVideos.length) { %>
                    <% cloudVideos.forEach(video => { %>
                      <div class="col-md-6 mb-4">
                        <div class="card">
                          <div class="card-body">
                            <h5 class="card-title"><%= video.title %></h5>
                            <div class="ratio ratio-16x9">
                              <!-- Use data-cloud-link so client JS can handle HLS (.m3u8) or direct MP4 links -->
                              <video controls preload="metadata" data-cloud-link="<%= video.cloud_link %>" style="width:100%;height:100%">
                                Your browser does not support the video tag.
                              </video>
                            </div>
                            <% if (video.description) { %>
                              <p class="video-description"><%= video.description %></p>
                            <% } %>
                          </div>
                        </div>
                      </div>
                    <% }); %>
                  <% } else { %>
                    <div class="col-12">
                      <p class="text-muted">No cloud-hosted videos available yet.</p>
                    </div>
                  <% } %>
                </div>
              </div>
            </section>

     <!-- service-sec  -->
      <section id="service-sec">
        <div class="container">
          <div class="row">
            <div class="col-12 mt-5 mb-3">
                <h1 class="text-center my-4 mx-2 px-4 py-4">Services</h1>
            </div>
          </div>
          <div class="row card-container g-4 p-3">
            <% if (menu && menu.length) { %>
              <% menu.forEach(item => { %>
                <div class="col-12 col-md-6 col-lg-3">
                  <div class="card h-100">
                    <img src="<%= item.image || 'images/default-menu.jpg' %>" class="card-img-top" alt="<%= item.name %>">
                    <div class="card-body d-flex flex-column">
                      <h5 class="card-title"><%= item.name %></h5>
                      <p class="card-text flex-grow-1"><%= item.description %></p>
                      <div class="mt-3">
                        <a href="#enrollment-sec" class="btn btn-warning">Enroll Now</a>
                        <a href="https://line.me/ti/p/ID8AwTQQtW" target="_blank" rel="noopener" class="btn btn-line ms-2">
                          <i class="fa-brands fa-line"></i> Line
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <!-- Fallback static cards -->
              <div class="col-12 col-md-6 col-lg-3">
                <div class="card">
                  <img src="images/home-delivery.jpg" class="card-img-top" alt="Beginner Course">
                    <div class="card-body">
                    <h5 class="card-title"><%= content.services ? content.services.beginner_title : 'Beginner Course' %></h5>
                    <p class="card-text"><%= content.services ? content.services.beginner_text : 'Foundations of English: vocabulary, basic grammar, simple conversations.' %></p>
                    <a href="#enrollment-sec" class="btn btn-warning">Enroll Now</a>
                  </div>
                </div>
              </div>
              <div class="col-12 col-md-6 col-lg-3">
                <div class="card">
                  <img src="images/birthday-party.webp" class="card-img-top" alt="Intermediate Course">
                    <div class="card-body">
                    <h5 class="card-title"><%= content.services ? content.services.intermediate_title : 'Intermediate Course' %></h5>
                    <p class="card-text"><%= content.services ? content.services.intermediate_text : 'Build fluency with guided speaking practice and expanded grammar.' %></p>
                    <a href="#enrollment-sec" class="btn btn-warning">Enroll Now</a>
                  </div>
                </div>
              </div>
              <div class="col-12 col-md-6 col-lg-3">
                <div class="card">
                  <img src="images/weeding.jpg" class="card-img-top" alt="Conversation Club">
                    <div class="card-body">
                    <h5 class="card-title"><%= content.services ? content.services.conversation_title : 'Conversation Club' %></h5>
                    <p class="card-text"><%= content.services ? content.services.conversation_text : 'Weekly speaking sessions to practice real-life topics with peers.' %></p>
                    <a href="#enrollment-sec" class="btn btn-warning">Enroll Now</a>
                  </div>
                </div>
              </div>
              <div class="col-12 col-md-6 col-lg-3">
                <div class="card">
                  <img src="images/event-party.jpg" class="card-img-top" alt="Exam Preparation">
                    <div class="card-body">
                    <h5 class="card-title"><%= content.services ? content.services.examprep_title : 'Exam Preparation' %></h5>
                    <p class="card-text"><%= content.services ? content.services.examprep_text : 'Targeted coaching for IELTS, TOEFL and other standardized tests.' %></p>
                    <a href="#enrollment-sec" class="btn btn-warning">Enroll Now</a>
                  </div>
                </div>
              </div>
            <% } %>
          </div>
        </div>
      </section>

      <!-- menu-sec -->
      <section id="menu-sec">
        <div class="container">
          <div class="row">
            <div class="col-12 mt-5 mb-3">
                <h1 class="text-center my-4 mx-2 px-4 py-4">Courses</h1>
            </div>
          </div>
          <div class="row">
            <% menu.forEach(item => { %>
              <div class="col-md-4 mb-4">
                <div class="card h-100">
                  <img src="<%= item.image || 'images/default-menu.jpg' %>" class="card-img-top course-thumb" alt="<%= item.name %>">
                  <div class="card-body d-flex flex-column">
                    <h5 class="card-title"><%= item.name %></h5>
                    <p class="card-text"><%= item.description %></p>
                    <p class="card-text"><strong>Baht <%= item.price %></strong></p>
                    <div class="card-actions mt-auto">
                      <a href="https://line.me/ti/p/ID8AwTQQtW" target="_blank" rel="noopener" class="btn btn-line btn-lg">
                        <i class="fa-brands fa-line"></i> Line
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </section>

      <!-- chef-sec -->
      <section id="chef-sec">
        <div class="container">
          <div class="row">
            <div class="col-12 mt-5 mb-3">
        <h1 class="text-center my-4 mx-2 px-4 py-4">Our Instructors</h1>
            </div>
          </div>
          <div class="row">
            <% chefs.forEach(chef => { %>
              <div class="col-md-4 mb-4">
                <div class="card">
                  <img src="<%= chef.image || 'images/default-chef.jpg' %>" class="card-img-top" alt="<%= chef.name %>">
                  <div class="card-body">
                    <h5 class="card-title"><%= chef.name %></h5>
                    <p class="card-text"><%= chef.role %></p>
               <p class="card-text"><small>Instructor</small></p>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </section>

      <!-- videos-sec -->
      <section id="videos-sec">
        <div class="container">
          <div class="row">
      <div class="col-12 mt-5 mb-3">
        <h1 class="text-center my-4 mx-2 px-4 py-4">Lesson Videos</h1>
      </div>
          </div>
          <div class="row">
            <% videos.forEach(video => { %>
              <div class="col-md-6 mb-4">
                <div class="card">
                  <div class="card-body">
                    <h5 class="card-title"><%= video.title %></h5>
                    <div class="ratio ratio-16x9">
                      <iframe src="https://www.youtube.com/embed/<%= video.embed_id %>" title="<%= video.title %>" allowfullscreen></iframe>
                    </div>
                    <% if (video.description) { %>
                      <p class="video-description"><%= video.description %></p>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </section>

  <!-- enrollment-sec -->
  <section id="enrollment-sec">
        <div class="container-fluid">
          <div class="row">
            <div class="col-12 mt-5 mb-4">
                <h1 class="text-center my-4 mx-2 px-4 py-4">Enrollment</h1>
            </div>
          </div>
          <div class="row justify-content-center mb-5">
            <div class="col-md-8">
              <div class="card p-4 contact-box">
                <form action="#" method="POST">
                  <div class="row g-3">
                    <div class="col-md-6">
                      <label class="form-label">Full Name</label>
                      <input type="text" name="name" class="form-control" placeholder="Your full name" required>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Email</label>
                      <input type="email" name="email" class="form-control" placeholder="you@example.com" required>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Phone (optional)</label>
                      <input type="tel" name="phone" class="form-control" placeholder="+66 1234 5678">
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Select Course</label>
                      <select name="course" class="form-select">
                        <option>Beginner Course</option>
                        <option>Intermediate Course</option>
                        <option>Conversation Club</option>
                        <option>Exam Preparation</option>
                      </select>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Preferred Start Date</label>
                      <input type="date" name="start_date" class="form-control">
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Preferred Time</label>
                      <input type="time" name="start_time" class="form-control">
                    </div>
                    <div class="col-12">
                      <label class="form-label">Message (optional)</label>
                      <textarea name="message" class="form-control" rows="3" placeholder="Any notes for the instructor"></textarea>
                    </div>
                    <div class="col-12">
                      <button type="submit" class="btn btn-primary btn-lg w-100">Enroll Now</button>
                    </div>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      </section>

